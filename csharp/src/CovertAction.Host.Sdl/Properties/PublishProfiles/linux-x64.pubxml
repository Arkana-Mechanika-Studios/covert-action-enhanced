<Project>
  <!-- A player's release for Linux x64 (also the Steam Deck): one self-contained program with libmt32emu.so and libSDL3.so.0
       beside it (native libraries the program loads from its own folder first). The SDL3 is SDL 3.4.20 built on Ubuntu 22.04
       (Native/linux-x64, csharp/tools/linux/build_sdl3.sh), so the game also runs where the system has no SDL3 (Ubuntu 24.04
       and older); deleting it makes the program use the system's libSDL3.so.0. The release archive is made by
       csharp/tools/publish_release.py --platform linux-x64 (a tar.gz that keeps the executable bits).
       dotnet publish csharp/src/CovertAction.Host.Sdl -p:PublishProfile=linux-x64
       (Reused from the Darklands Restoration Project's linux-x64 publish profile.) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- no .pdb files of the referenced projects beside the program -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\build\linux\publish\</PublishDir>
  </PropertyGroup>
</Project>
